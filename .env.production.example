# Production settings for docker-compose.yml. Copy to .env.production (git
# ignores it) and fill in every value. Generate secrets with
#   openssl rand -hex 32
# (hex only: the database passwords go into connection URLs).

# Addresses. DNS: *.PUBLIC_DOMAIN, ADMIN_DOMAIN, *.ADMIN_DOMAIN and API_DOMAIN
# all point at this machine.
PUBLIC_DOMAIN=dcms.couteret.fr
ADMIN_DOMAIN=admin.couteret.fr
API_DOMAIN=api.couteret.fr

# Database roles (set on the first start; changing them later needs ALTER ROLE).
POSTGRES_PASSWORD=
DIVEAPP_PASSWORD=
DCMS_APP_PASSWORD=

# Signing keys: the API's tokens, and the backoffice's sessions.
JWT_SECRET=
JWT_EXPIRES_IN=1d
AUTH_SECRET=

# Outgoing email (invitations). Empty: no email is sent and the superadmin
# console shows invitation links instead.
SMTP_URL=
MAIL_FROM=DCMS <no-reply@couteret.fr>

# Extra browser origins allowed to call the API (centers' sites are always
# allowed). Usually empty.
ALLOWED_ORIGINS=
