# The API, as the browser reaches it (guest bookings are posted from the browser).
NEXT_PUBLIC_API_URL=https://api.couteret.fr
# The API as this server reaches it, if different (server-side calls).
# API_URL=http://localhost:4000

# Each center's site is {slug}.<TENANT_DOMAIN>, e.g. deepblue.dcms.couteret.fr.
TENANT_DOMAIN=dcms.couteret.fr
# Development only: the center for hosts that are not a center subdomain
# (localhost, an IP address). Unset in production: such hosts get 404.
# DEFAULT_TENANT_SLUG=default
