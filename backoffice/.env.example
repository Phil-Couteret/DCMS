# The API, as this server reaches it.
NEXT_PUBLIC_API_URL=https://api.couteret.fr

# Each center's backoffice is {slug}.<TENANT_DOMAIN> (e.g.
# deepblue.admin.couteret.fr): sign-in there is for that center, and a
# session for another center is sent to that center's address. TENANT_DOMAIN
# itself is the platform address (superadmin console). Unset, the address
# names no center.
TENANT_DOMAIN=admin.couteret.fr

# Development only: the center for partner sign-in by email on a host that
# names none (localhost, an IP address).
# DEFAULT_TENANT_SLUG=default
