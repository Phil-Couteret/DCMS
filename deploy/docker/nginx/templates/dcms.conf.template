# DCMS behind nginx: TLS, and routing by host name. ${PUBLIC_DOMAIN},
# ${ADMIN_DOMAIN} and ${API_DOMAIN} are filled in from the environment when
# the container starts (docker-compose.yml).

server_tokens off;

# The visitor's address, scheme and host, for the apps behind (rate limits,
# center from the host, Auth.js URLs). The host is passed as the browser sent
# it, port included: Next.js checks it against the Origin of server actions.
# server_name below has already matched it to a known address.
proxy_set_header Host $http_host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $http_host;
proxy_http_version 1.1;

ssl_certificate     /etc/nginx/certs/fullchain.pem;
ssl_certificate_key /etc/nginx/certs/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;

# Everything to https. Certificate renewals (HTTP-01) can use the webroot.
server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# Any other host name: closed without an answer, so a forged Host never
# reaches the apps.
server {
    listen 443 ssl default_server;
    server_name _;
    return 444;
}

# The API.
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};
    client_max_body_size 2m;
    location / { proxy_pass http://backend:4000; }
}

# Each center's public site.
server {
    listen 443 ssl;
    http2 on;
    server_name *.${PUBLIC_DOMAIN};
    location / { proxy_pass http://frontend:3000; }
}

# The platform address and each center's backoffice.
server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN} *.${ADMIN_DOMAIN};
    client_max_body_size 2m;
    location / { proxy_pass http://backoffice:3001; }
}
