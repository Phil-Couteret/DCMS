DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dive_center?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Tenants are named by subdomain: {slug}.<domain> for each domain here (the
# public sites and the backoffices). Requests from (Origin) or to (Host) such
# a host act for that tenant, and its origin may call the API (CORS).
TENANT_DOMAINS="dcms.couteret.fr,admin.couteret.fr"

# A center's backoffice address, for invitation links: {slug} is replaced by
# the center's slug. Without {slug}, one address for every center.
BACKOFFICE_URL="https://{slug}.admin.couteret.fr"

# Outgoing email (invitations). Unset: nothing is sent, and the superadmin
# console shows the invitation link to pass on instead.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_FROM="DCMS <no-reply@couteret.fr>"

# Row-level security (step 6). The API should connect as a role that does not
# own the tables (prisma/sql/create-app-role.sql creates dcms_app), and
# migrations as the owner. Without MIGRATION_DATABASE_URL both use
# DATABASE_URL, and the policies still apply (FORCE ROW LEVEL SECURITY).
# MIGRATION_DATABASE_URL="postgresql://diveapp:password@localhost:5432/divedb"
