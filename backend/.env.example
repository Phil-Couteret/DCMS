DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dive_center?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Tenants are named by subdomain: {slug}.<domain> for each domain here (the
# public sites and the backoffices). Requests from (Origin) or to (Host) such
# a host act for that tenant, and its origin may call the API (CORS).
TENANT_DOMAINS="dcms.couteret.fr,admin.couteret.fr"
