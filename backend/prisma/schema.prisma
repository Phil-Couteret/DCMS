generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  INSTRUCTOR
  ADMIN
}

enum CustomerType {
  TOURIST
  LOCAL
  RECURRENT
}

// Staff's operational assessment of the diver, independent of certification.
enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum Language {
  ES
  EN
  DE
  FR
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

// A dive center (company) using the platform. Every business record belongs
// to exactly one tenant; users are global and reach tenants through
// memberships (staff) or a customer profile (customers).
model Tenant {
  id                     String                  @id @default(uuid())
  name                   String
  slug                   String                  @unique // {slug}.dcms.<domain>
  plan                   TenantPlan              @default(FREE)
  isActive               Boolean                 @default(true)
  // Authorized limits, shown against usage in the superadmin console:
  // { locations, diveSites, boats, users, customers, storageGb,
  // storagePricePerGbMonth }. Missing keys take the platform defaults
  // (superadmin/quotas.ts). Not enforced yet (MULTITENANT_PLAN.md step 7).
  quotas                 Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  customers              Customer[]
  customerCertifications CustomerCertification[]
  centerSettings         CenterSettings?
  activityPrices         ActivityPrice[]
  equipmentPrices        EquipmentPrice[]
  funDiveTiers           FunDiveTier[]
  boats                  Boat[]
  diveSites              DiveSite[]
  equipment              Equipment[]
  staff                  Staff[]
  staffQualifications    StaffQualification[]
  staffAvailability      StaffAvailability[]
  bookings               Booking[]
  trips                  Trip[]
  tripStaff              TripStaff[]
  diveLogs               DiveLog[]
  diveLogParticipants    DiveLogParticipant[]
  diveLogSignatures      DiveLogSignature[]
  incidents              Incident[]
  invoices               Invoice[]
  invoiceItems           InvoiceItem[]
  payments               Payment[]
  refunds                Refund[]
  maintenanceLogs        MaintenanceLog[]
  expenses               Expense[]
  manualIncomes          ManualIncome[]
  closedDays             ClosedDay[]
  stays                  Stay[]
  stayCosts              StayCost[]
  partners               Partner[]
  partnerInvoices        PartnerInvoice[]
  partnerInvoiceLines    PartnerInvoiceLine[]
  dataBreaches           DataBreach[]
  locations              Location[]
  memberships            Membership[]
  platformAudit          PlatformAuditLog[]
  numberSequences        NumberSequence[]
  governmentBonos        GovernmentBono[]
  tanks                  Tank[]
  customerDocuments      CustomerDocument[]
  addOnPrices            AddOnPrice[]
  customerAccounts       User[]                  @relation("CustomerAccounts")
  divePacks              DivePack[]
  invitations            Invitation[]
}

enum LocationType {
  DIVING
  BIKE
  SURF
  KITE
}

// A site a tenant operates from. Boats, sites and bookings are attached to
// locations in step 3 (MULTITENANT_PLAN.md).
model Location {
  id          String       @id @default(uuid())
  tenantId    String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  type        LocationType @default(DIVING)
  address     Json?
  contactInfo Json?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  // What operates from here. Deleting the location unassigns them.
  boats       Boat[]
  tanks       Tank[]
  diveSites   DiveSite[]
  bookings    Booking[]

  @@index([tenantId])
}

// A tenant's staff role for an account (global User). Roles are per center:
// the same person can be an admin at one and an instructor at another.
enum MembershipRole {
  ADMIN
  INSTRUCTOR
}

// Gives a staff or admin account access to a tenant, with its role there.
// An inactive membership keeps the record but grants no access.
model Membership {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      MembershipRole @default(INSTRUCTOR)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// A government discount voucher (e.g. the Canary Islands' "bono"): a code
// staff enter on a booking. Its discount is applied when the booking is
// invoiced, which is also when a use is counted.
enum BonoType {
  PERCENTAGE
  FIXED
}

model GovernmentBono {
  id            String    @id @default(uuid())
  tenantId      String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Stored upper case; unique per tenant.
  code          String
  type          BonoType
  // A percentage (PERCENTAGE) or an amount in the center's currency (FIXED).
  discountValue Decimal   @db.Decimal(10, 2)
  description   String
  validFrom     DateTime  @db.Date
  validTo       DateTime? @db.Date
  usageLimit    Int?
  usageCount    Int       @default(0)
  isActive      Boolean   @default(true)
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

// A dive cylinder and its periodic tests. The dates are when each test was
// last done; the next one is due a fixed interval later (tanks.rules.ts).
enum TankStatus {
  ACTIVE
  RETIRED
}

model Tank {
  id                   String     @id @default(uuid())
  tenantId             String     @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  locationId           String?
  location             Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  serialNumber         String
  // 10L, 12L, 15L, Nitrox12L or Nitrox15L.
  size                 String
  visualInspectionDate DateTime?  @db.Date
  hydrostaticTestDate  DateTime?  @db.Date
  status               TankStatus @default(ACTIVE)
  notes                String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@unique([tenantId, serialNumber])
  @@index([tenantId])
}

// A file kept with a customer's record (medical certificate, insurance,
// certification card…). The file itself is on disk under UPLOAD_DIR, at
// storagePath (relative): {tenantId}/{customerId}/{id}{extension}.
enum CustomerDocumentType {
  MEDICAL_CERT
  INSURANCE
  CERTIFICATION
  OTHER
}

model CustomerDocument {
  id          String               @id @default(uuid())
  tenantId    String               @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customerId  String
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        CustomerDocumentType
  // The name it was uploaded with, shown and offered on download only.
  filename    String
  mimeType    String
  size        Int
  storagePath String
  uploadedBy  String?
  uploadedAt  DateTime             @default(now())
  createdAt   DateTime             @default(now())

  @@index([tenantId])
  @@index([customerId])
}

// An invitation to join a tenant's staff, sent by email as a link with a
// one-time token (only its SHA-256 is stored). Accepting it creates the
// account (or, for an existing one, checks its password) and the
// membership. A global model: it is accepted before any tenant is known.
model Invitation {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  role        MembershipRole @default(ADMIN)
  tokenHash   String         @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  // A newer invitation to the same email and tenant replaces this one.
  revokedAt   DateTime?
  invitedById String?
  invitedBy   User?          @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([tenantId])
  @@index([email])
}

// Platform-level actions: tenants created or changed by a superadmin, and
// every time a superadmin enters a tenant they are not a member of.
model PlatformAuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// A login. Staff and platform accounts are global (tenantId null): one per
// person, with a membership per center they work for. Customer accounts
// belong to one tenant (company): a diver has one login per company, shared
// by all its locations, and a separate one at any other company. Emails are
// unique among global accounts, and within each tenant among its customer
// accounts.
model User {
  id              String             @id @default(uuid())
  email           String
  // The company a customer account belongs to; null for staff and platform
  // accounts. (A staff member's own customer profile at their center uses
  // their staff account.)
  tenantId        String?
  tenant          Tenant?            @relation("CustomerAccounts", fields: [tenantId], references: [id], onDelete: Restrict)
  passwordHash    String
  name            String?
  role            Role               @default(CUSTOMER)
  // Platform operator: manages tenants and may enter any of them (audited).
  // The very first account created becomes one (trigger, migration
  // multitenancy_accounts).
  isSuperadmin    Boolean            @default(false)
  // Its customer and staff profiles, per tenant.
  customers       Customer[]
  staffProfiles   Staff[]
  memberships     Membership[]
  dataBreaches    DataBreach[]
  platformAudit   PlatformAuditLog[]
  invitationsSent Invitation[]       @relation("InvitationsSent")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([email], map: "User_email_key", where: raw("\"tenantId\" IS NULL"))
  @@unique([tenantId, email], map: "User_tenantId_email_key", where: raw("\"tenantId\" IS NOT NULL"))
}

model Customer {
  id                    String                  @id @default(uuid())
  tenantId              String                  @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId                String
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  phone                 String?
  country               String
  language              Language                @default(EN)
  birthdate             DateTime?
  emergencyContact      Json?
  gender                String?
  notes                 String?                 @db.Text
  loyaltyPoints         Int                     @default(0)
  totalDives            Int                     @default(0)
  customerType          CustomerType            @default(TOURIST)
  centerSkillLevel      SkillLevel?
  isApproved            Boolean                 @default(true)
  // Verification is cleared when the number or expiry changes.
  medicalCertNumber     String?
  medicalCertExpiry     DateTime?
  medicalCertVerifiedAt DateTime?
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?
  insuranceVerifiedAt   DateTime?
  // ownEquipment: brings a full set; the tank is always the center's.
  ownEquipment          Boolean                 @default(false)
  tankSize              String?
  bcdSize               String?
  wetsuitSize           String?
  finsSize              String?
  bootsSize             String?
  certifications        CustomerCertification[]
  bookings              Booking[]
  diveLogEntries        DiveLogParticipant[]
  invoices              Invoice[]
  stays                 Stay[]
  // The partner who registered this customer, if any.
  partnerId             String?
  partner               Partner?                @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  documents             CustomerDocument[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([tenantId, userId])
  @@index([country])
}

// A diving certification staff recorded from the diver's card.
model CustomerCertification {
  id         String    @id @default(uuid())
  tenantId   String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agency     String
  level      String
  cardNumber String?
  issueDate  DateTime?
  expiryDate DateTime?
  verifiedAt DateTime?
  verifiedBy String? // email of the staff member who verified it
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId])
  @@index([tenantId])
}

// The dive center's own details, shown on invoices and in the backoffice.
model CenterSettings {
  // One row per tenant.
  tenantId                       String   @id @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant                         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name                           String
  legalName                      String?
  address                        String?
  phone                          String?
  email                          String?
  website                        String?
  // Percentage added to net prices on invoices, e.g. 7.00 for 7%.
  taxRate                        Decimal  @default(7.00) @db.Decimal(5, 2)
  taxName                        String   @default("IGIC")
  // IANA time zone of the center: its days (closing, "today", invoice years)
  // and the wall-clock times staff enter and read.
  timeZone                       String   @default("Atlantic/Canary")
  // ISO 4217 code of prices, invoices and payments.
  currency                       String   @default("EUR")
  // New customers' language when none is given; the public site's default.
  defaultLanguage                Language @default(EN)
  // Public site branding: an https URL and #rrggbb colours.
  logoUrl                        String?
  primaryColor                   String?
  accentColor                    String?
  // Invoice numbers are PREFIX-YYYY-0001, one series per tenant and year.
  invoicePrefix                  String   @default("INV")
  partnerInvoicePrefix           String   @default("PINV")
  // How often each tank test is due, in months after the last one
  // (Equipment → Tanks). Set by admins; rules vary by country.
  visualInspectionIntervalMonths Int      @default(12)
  hydrostaticTestIntervalMonths  Int      @default(60)
  updatedAt                      DateTime @updatedAt
}

enum NumberSeries {
  INVOICE
  PARTNER_INVOICE
  DIVE_LOG
}

// The last number given in each series, per tenant and year. Taken with an
// atomic upsert inside the transaction that uses it: the row stays locked
// until commit, and a rolled-back create gives its number back, so a series
// has no gaps (required for invoices in Spain) and no duplicates.
model NumberSequence {
  tenantId String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  series   NumberSeries
  year     Int
  last     Int

  @@id([tenantId, series, year])
}

// The price list, net of tax. Edited in Settings → Pricing; invoices and the
// public site read it. An activity without a row has no price and cannot be
// invoiced.
model ActivityPrice {
  tenantId     String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  activityType ActivityType
  price        Decimal      @db.Decimal(8, 2)
  updatedAt    DateTime     @updatedAt

  @@id([tenantId, activityType])
}

// Rental items by key (wetsuit, bcd, regulator, maskFins, diveComputer) and
// fullPackage, the price of all five hired together.
model EquipmentPrice {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  key       String
  price     Decimal  @db.Decimal(8, 2)
  updatedAt DateTime @updatedAt

  @@id([tenantId, key])
}

// Per-dive rate for fun dives billed together in a stay, from minDives fun
// dives in the stay on, by customer type. The lowest tier starts at 1.
model FunDiveTier {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  minDives  Int
  tourist   Decimal  @db.Decimal(8, 2)
  local     Decimal  @db.Decimal(8, 2)
  recurrent Decimal  @db.Decimal(8, 2)
  updatedAt DateTime @updatedAt

  @@id([tenantId, minDives])
}

// Extras booked with an activity, priced in Settings → Pricing (AddOnPrice).
enum BookingAddOn {
  NIGHT_DIVE
  PERSONAL_INSTRUCTOR
}

// The price of each add-on: the night dive surcharge (per diver) and the
// personal instructor fee (per booking).
model AddOnPrice {
  tenantId  String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  addOn     BookingAddOn
  price     Decimal      @db.Decimal(8, 2)
  updatedAt DateTime     @updatedAt

  @@id([tenantId, addOn])
}

// A fixed price for a number of fun dives (per diver), offered when a stay's
// fun dives come to exactly that many.
model DivePack {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  diveCount Int
  price     Decimal  @db.Decimal(8, 2)
  updatedAt DateTime @updatedAt

  @@id([tenantId, diveCount])
}

model Boat {
  id                 String    @id @default(uuid())
  tenantId           String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // The location it operates from; null: not assigned.
  locationId         String?
  location           Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name               String
  capacity           Int
  status             String    @default("active")
  registrationNumber String
  length             Decimal?  @db.Decimal(5, 2)
  engine             String?
  insuranceExpiry    DateTime?
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  bookings           Booking[]
  trips              Trip[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId])
  @@index([locationId])
}

model DiveSite {
  id                String    @id @default(uuid())
  tenantId          String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // The location its trips leave from; null: not assigned.
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  // A shore dive site (beach, harbour, pool) where shore trips take place.
  isShore           Boolean   @default(false)
  nameEs            String
  nameEn            String
  nameDe            String
  nameFr            String
  descriptionEs     String    @db.Text
  descriptionEn     String    @db.Text
  descriptionDe     String    @db.Text
  descriptionFr     String    @db.Text
  latitude          Decimal   @db.Decimal(10, 7)
  longitude         Decimal   @db.Decimal(10, 7)
  depthMin          Int
  depthMax          Int
  requiredCertLevel Int
  difficultyLevel   Int
  typicalVisibility Int?
  typicalCurrent    String    @default("none")
  waterTempRange    Json
  marineLife        Json
  pointsOfInterest  Json
  bestSeason        Json
  travelTimeMinutes Int
  maxDiversPerTrip  Int
  accessibility     String    @default("boat_only")
  facilities        Json
  restrictions      Json?
  photos            Json      @default("[]")
  totalDives        Int       @default(0)
  averageRating     Decimal?  @db.Decimal(3, 2)
  bookings          Booking[]
  diveLogs          DiveLog[]
  plannedTrips      Trip[]    @relation("TripPlannedSite")
  actualTrips       Trip[]    @relation("TripActualSite")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@index([locationId])
}

enum EquipmentStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  DECOMMISSIONED
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

model Equipment {
  id              String             @id @default(uuid())
  tenantId        String             @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type            String
  brand           String
  model           String?
  size            String?
  serialNumber    String?
  status          EquipmentStatus    @default(AVAILABLE)
  condition       EquipmentCondition @default(EXCELLENT)
  purchaseDate    DateTime
  purchaseCost    Decimal            @db.Decimal(10, 2)
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  maintenanceLogs MaintenanceLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([tenantId, serialNumber])
}

enum StaffType {
  GUIDE
  TRAINER
  CAPTAIN
  ADMIN
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model Staff {
  id             String               @id @default(uuid())
  tenantId       String               @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  phone          String
  type           StaffType
  status         StaffStatus          @default(ACTIVE)
  hireDate       DateTime
  qualifications StaffQualification[]
  availability   StaffAvailability[]
  diveLogs       DiveLog[]
  trips          TripStaff[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([tenantId, userId])
}

model StaffQualification {
  id         String    @id @default(uuid())
  tenantId   String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type       String
  agency     String
  number     String
  issueDate  DateTime
  expiryDate DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model StaffAvailability {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime
  available Boolean  @default(true)
  reason    String?

  @@unique([staffId, date])
  @@index([tenantId])
}

enum ActivityType {
  SNORKELING
  DISCOVER_SCUBA
  FUN_DIVE
  OW_CERT
  AOW_CERT
  RESCUE_CERT
  DM_CERT
}

enum TimeSlot {
  MORNING
  AFTERNOON
  NIGHT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  DIRECT
  WALK_IN
  PARTNER
}

model Booking {
  id               String          @id @default(uuid())
  tenantId         String          @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Where the booking takes place. Set from its boat when not given
  // (trigger booking_location, migration add_location_to_resources).
  locationId       String?
  location         Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // A boat booking has a boat; a shore booking (no boat) has a shoreTime and
  // its shore trip. Exactly one of boatId and shoreTime is set.
  boatId           String?
  boat             Boat?           @relation(fields: [boatId], references: [id], onDelete: Restrict)
  // HH:mm, center time: the shore session it is booked on.
  shoreTime        String?         @db.VarChar(5)
  siteId           String?
  site             DiveSite?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  tripId           String?
  trip             Trip?           @relation(fields: [tripId], references: [id], onDelete: SetNull)
  activityType     ActivityType
  date             DateTime
  timeSlot         TimeSlot
  status           BookingStatus   @default(PENDING)
  participantCount Int
  // Dives in this booking (fun dives are billed per dive). At least 1.
  numberOfDives    Int             @default(1)
  // A government bono applied to this booking (discount on invoicing).
  bonoId           String?
  bono             GovernmentBono? @relation(fields: [bonoId], references: [id], onDelete: Restrict)
  // The bono's use has been counted (when the booking was invoiced); a
  // cancelled invoice gives it back.
  bonoUsed         Boolean         @default(false)
  // Night dive, personal instructor: billed on top of the activity.
  addOns           BookingAddOn[]  @default([])
  // Prices locked when the booking was made (or when what it is for changed),
  // so later price list changes do not reprice it. Null on bookings from
  // before prices were locked: those use the current price list.
  //   pricePerDiver: the activity's price per diver (per dive for fun dives
  //     invoiced on their own);
  //   equipmentPrice: the hired equipment set, as booked;
  //   addOnPrices: { NIGHT_DIVE, PERSONAL_INSTRUCTOR } unit prices;
  //   funDiveTiers: the volume rates; a stay uses its earliest booking's.
  pricePerDiver    Decimal?        @db.Decimal(8, 2)
  equipmentPrice   Decimal?        @db.Decimal(8, 2)
  addOnPrices      Json?
  funDiveTiers     Json?
  bookingSource    BookingSource   @default(DIRECT)
  notes            String?
  diveLog          DiveLog?
  invoice          Invoice?
  // Set when the booking is billed as part of a stay.
  stayId           String?
  stay             Stay?           @relation(fields: [stayId], references: [id], onDelete: SetNull)
  // The partner (agency) that sold it: they pay the activity, less commission.
  partnerId        String?
  partner          Partner?        @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  // Set while the booking is on a partner invoice that is not cancelled.
  partnerInvoiceId String?
  partnerInvoice   PartnerInvoice? @relation(fields: [partnerInvoiceId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([boatId, date])
  @@index([customerId])
  @@index([status])
  @@index([date, timeSlot])
  @@index([tripId])
  @@index([stayId])
  @@index([partnerId])
  @@index([partnerInvoiceId])
  @@index([tenantId])
  @@index([locationId])
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TripStaffRole {
  CAPTAIN
  GUIDE
  TRAINEE_GUIDE
}

// One outing: a boat (or, with no boat, a shore dive) on a date and time slot.
model Trip {
  id            String      @id @default(uuid())
  tenantId      String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  date          DateTime
  timeSlot      TimeSlot
  boatId        String?
  boat          Boat?       @relation(fields: [boatId], references: [id], onDelete: Restrict)
  // A shore trip (beach, harbour or pool: discovery dives, courses, night
  // dives) has no boat. isShore is true exactly when boatId is null.
  isShore       Boolean     @default(false)
  // A shore trip's start, HH:mm in center time: one of the slot's 30-minute
  // starts (SHORE_START_TIMES). Null for boat trips, and for shore trips
  // from before start times.
  startTime     String?     @db.VarChar(5)
  plannedSiteId String?
  plannedSite   DiveSite?   @relation("TripPlannedSite", fields: [plannedSiteId], references: [id], onDelete: SetNull)
  actualSiteId  String?
  actualSite    DiveSite?   @relation("TripActualSite", fields: [actualSiteId], references: [id], onDelete: SetNull)
  status        TripStatus  @default(PLANNED)
  maxDivers     Int         @default(10)
  notes         String?
  // Post-dive report, in center local time (HH:mm).
  entryTime     String?     @db.VarChar(5)
  exitTime      String?     @db.VarChar(5)
  reportNotes   String?     @db.Text
  completedAt   DateTime?
  bookings      Booking[]
  staff         TripStaff[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // PostgreSQL treats NULLs as distinct, so this does not stop two shore
  // trips (boatId null) at the same time and site. TripsService and
  // shoreTripFor check that case.
  @@unique([tenantId, date, timeSlot, boatId])
  @@index([date])
}

model TripStaff {
  id          String        @id @default(uuid())
  tenantId    String        @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  staffId     String
  staff       Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  role        TripStaffRole
  confirmedAt DateTime?

  @@unique([tripId, staffId])
  @@index([staffId])
  @@index([tenantId])
}

enum IncidentSeverity {
  MINOR
  MODERATE
  SERIOUS
  CRITICAL
}

model DiveLog {
  id                String               @id @default(uuid())
  tenantId          String               @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  logNumber         String
  bookingId         String               @unique
  booking           Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  siteId            String
  site              DiveSite             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  guideId           String?
  guide             Staff?               @relation(fields: [guideId], references: [id], onDelete: SetNull)
  date              DateTime
  entryTime         DateTime
  exitTime          DateTime
  maxDepth          Int
  avgDepth          Int?
  duration          Int
  visibility        Int?
  waterTemp         Int?
  weatherConditions String?
  seaConditions     String?
  airStartBar       Int?
  airEndBar         Int?
  notes             String?
  participants      DiveLogParticipant[]
  signatures        DiveLogSignature[]
  incident          Incident?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([tenantId, logNumber])
}

model DiveLogParticipant {
  id         String   @id @default(uuid())
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  diveLogId  String
  diveLog    DiveLog  @relation(fields: [diveLogId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  role       String   @default("diver")

  @@unique([diveLogId, customerId])
  @@index([tenantId])
}

model DiveLogSignature {
  id            String   @id @default(uuid())
  tenantId      String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  diveLogId     String
  diveLog       DiveLog  @relation(fields: [diveLogId], references: [id], onDelete: Cascade)
  signerType    String
  signerId      String
  signerName    String
  signatureData String   @db.Text
  signedAt      DateTime @default(now())

  @@index([tenantId])
}

model Incident {
  id                    String           @id @default(uuid())
  tenantId              String           @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  diveLogId             String           @unique
  diveLog               DiveLog          @relation(fields: [diveLogId], references: [id], onDelete: Cascade)
  type                  String
  severity              IncidentSeverity
  description           String           @db.Text
  actionsTaken          String           @db.Text
  reportedToAuthorities Boolean          @default(false)
  createdAt             DateTime         @default(now())

  @@index([tenantId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String        @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceNumber String
  // Exactly one of bookingId and stayId is set (a CHECK constraint in the
  // database): an invoice bills one booking, or a whole stay.
  bookingId     String?       @unique
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  stayId        String?
  stay          Stay?         @relation(fields: [stayId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  currency      String        @default("EUR")
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([stayId])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  tenantId    String  @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  type        String

  @@index([tenantId])
}

model Payment {
  id              String        @id @default(uuid())
  tenantId        String        @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("EUR")
  method          PaymentMethod
  stripePaymentId String?       @unique
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  refunds         Refund[]
  createdAt       DateTime      @default(now())

  @@index([tenantId])
}

model Refund {
  id             String   @id @default(uuid())
  tenantId       String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount         Decimal  @db.Decimal(10, 2)
  reason         String
  stripeRefundId String?  @unique
  processedAt    DateTime @default(now())

  @@index([tenantId])
}

model MaintenanceLog {
  id          String    @id @default(uuid())
  tenantId    String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date        DateTime
  technician  String
  type        String
  notes       String?
  cost        Decimal?  @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  @@index([equipmentId, date])
  @@index([tenantId])
}

// Financial page: day-to-day money that does not go through invoices.

enum ExpenseCategory {
  GASOLINE
  TANK_NET
  GLUE
  EQUIPMENT
  MAINTENANCE
  OTHER
}

// amount includes tax; tax is the part of it that can be deducted on the
// quarterly declaration.
model Expense {
  id          String          @id @default(uuid())
  tenantId    String          @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  date        DateTime        @db.Date
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  tax         Decimal         @db.Decimal(10, 2)
  notes       String?
  createdBy   String? // email of the staff member who recorded it
  createdAt   DateTime        @default(now())

  @@index([date])
  @@index([tenantId])
}

// Income that is not an invoice payment, e.g. an equipment sale.
model ManualIncome {
  id          String   @id @default(uuid())
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  date        DateTime @db.Date
  description String
  amount      Decimal  @db.Decimal(10, 2)
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([tenantId])
}

// A day's figures frozen when staff close the day. Closing again replaces them.
model ClosedDay {
  id       String   @id @default(uuid())
  tenantId String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  date     DateTime @db.Date
  summary  Json
  closedBy String
  closedAt DateTime @default(now())

  @@unique([tenantId, date])
}

// A customer's visit: their bookings over up to 30 days, billed together on
// one invoice with volume pricing for fun dives. The bookings in an open stay
// are worked out from the dates (StaysService); this row holds the extra costs
// and, once billed, which bookings the invoice covered. A customer has at most
// one OPEN stay (StaysService takes a per-customer lock).
enum StayStatus {
  OPEN
  BILLED
}

enum StayCostCategory {
  INSURANCE
  EQUIPMENT
  CLOTHES
  GOODIES
  BEVERAGES
  OTHER
}

model Stay {
  id         String     @id @default(uuid())
  tenantId   String     @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status     StayStatus @default(OPEN)
  billedAt   DateTime?
  bookings   Booking[]
  costs      StayCost[]
  invoices   Invoice[] // a cancelled invoice reopens the stay; billing again adds one
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, status])
  @@index([tenantId])
}

// Sold during a stay and billed with it: insurance, merchandise, drinks.
// Prices are net; the invoice adds tax.
model StayCost {
  id          String           @id @default(uuid())
  tenantId    String           @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stayId      String
  stay        Stay             @relation(fields: [stayId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  category    StayCostCategory
  description String
  quantity    Int
  unitPrice   Decimal          @db.Decimal(10, 2)
  total       Decimal          @db.Decimal(10, 2)
  notes       String?
  createdBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([stayId])
  @@index([tenantId])
}

// An agency or reseller that sells the center's activities to its own
// clients. It signs in to the partner portal with its contact email or API
// key and the API secret, which is stored hashed and shown only once.
model Partner {
  id             String           @id @default(uuid())
  tenantId       String           @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name           String
  companyName    String
  contactEmail   String
  contactPhone   String?
  // Percentage of the booking value the partner keeps, e.g. 15.00.
  commissionRate Decimal          @db.Decimal(5, 2)
  isActive       Boolean          @default(true)
  apiKey         String           @unique
  apiSecretHash  String
  notes          String?
  bookings       Booking[]
  customers      Customer[]
  invoices       PartnerInvoice[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, contactEmail])
}

enum PartnerInvoiceStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

// What a partner owes the center for its bookings in a period: their
// catalogue value less the partner's commission, plus tax. Amounts and the
// rates used are copied at creation so the invoice never changes afterwards.
model PartnerInvoice {
  id             String               @id @default(uuid())
  tenantId       String               @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceNumber  String // PINV-YYYY-0001, numbered per tenant
  partnerId      String
  partner        Partner              @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  periodFrom     DateTime             @db.Date
  periodTo       DateTime             @db.Date
  dueDate        DateTime             @db.Date
  commissionRate Decimal              @db.Decimal(5, 2)
  gross          Decimal              @db.Decimal(10, 2) // catalogue value of the bookings
  commission     Decimal              @db.Decimal(10, 2)
  subtotal       Decimal              @db.Decimal(10, 2) // gross - commission
  taxName        String
  taxRate        Decimal              @db.Decimal(5, 2)
  tax            Decimal              @db.Decimal(10, 2)
  total          Decimal              @db.Decimal(10, 2)
  paidAmount     Decimal              @default(0) @db.Decimal(10, 2)
  status         PartnerInvoiceStatus @default(PENDING)
  paidAt         DateTime?
  notes          String?
  createdBy      String?
  lines          PartnerInvoiceLine[]
  bookings       Booking[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([partnerId])
}

// One booking on a partner invoice, as it was valued then.
model PartnerInvoiceLine {
  id               String         @id @default(uuid())
  tenantId         String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  partnerInvoiceId String
  partnerInvoice   PartnerInvoice @relation(fields: [partnerInvoiceId], references: [id], onDelete: Cascade)
  bookingId        String // kept as text: the line stays if the booking is deleted
  date             DateTime       @db.Date
  description      String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(10, 2)
  total            Decimal        @db.Decimal(10, 2)

  @@index([partnerInvoiceId])
  @@index([tenantId])
}

enum BreachSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Moves forward only: DETECTED → ASSESSED → REPORTED → RESOLVED, steps may
// be skipped (a breach unlikely to harm anyone need not be reported).
enum BreachStatus {
  DETECTED
  ASSESSED
  REPORTED
  RESOLVED
}

// The GDPR data breach register (Art. 33(5)). A breach must be reported to
// the authority within 72 hours of detectedAt; one still DETECTED or ASSESSED
// after that, and not reported, is overdue.
model DataBreach {
  id                  String         @id @default(uuid())
  tenantId            String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  title               String
  detectedAt          DateTime
  severity            BreachSeverity
  status              BreachStatus   @default(DETECTED)
  description         String         @db.Text
  // Array of data type keys, e.g. ["customer_data", "medical_data"].
  affectedDataTypes   Json
  estimatedAffected   Int?
  reportedToAuthority Boolean        @default(false)
  reportedAt          DateTime?
  authorityReference  String?
  resolutionDetails   String?        @db.Text
  resolutionDate      DateTime?
  createdById         String
  createdBy           User           @relation(fields: [createdById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status])
  @@index([detectedAt])
  @@index([tenantId])
}
