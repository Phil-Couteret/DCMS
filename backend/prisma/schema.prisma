generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  INSTRUCTOR
  ADMIN
}

enum Language {
  ES
  EN
  DE
  FR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(CUSTOMER)
  customer     Customer?
  staff        Staff?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String?
  country          String
  language         Language  @default(EN)
  birthdate        DateTime?
  emergencyContact Json?
  loyaltyPoints    Int       @default(0)
  totalDives       Int       @default(0)
  bookings         Booking[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([country])
}

model Boat {
  id                 String    @id @default(uuid())
  name               String
  capacity           Int
  status             String    @default("active")
  registrationNumber String
  length             Decimal?  @db.Decimal(5, 2)
  engine             String?
  insuranceExpiry    DateTime?
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  bookings           Booking[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model DiveSite {
  id                String   @id @default(uuid())
  nameEs            String
  nameEn            String
  nameDe            String
  nameFr            String
  descriptionEs     String   @db.Text
  descriptionEn     String   @db.Text
  descriptionDe     String   @db.Text
  descriptionFr     String   @db.Text
  latitude          Decimal  @db.Decimal(10, 7)
  longitude         Decimal  @db.Decimal(10, 7)
  depthMin          Int
  depthMax          Int
  requiredCertLevel Int
  difficultyLevel   Int
  typicalVisibility Int?
  typicalCurrent    String   @default("none")
  waterTempRange    Json
  marineLife        Json
  pointsOfInterest  Json
  bestSeason        Json
  travelTimeMinutes Int
  maxDiversPerTrip  Int
  accessibility     String   @default("boat_only")
  facilities        Json
  restrictions      Json?
  photos            Json     @default("[]")
  totalDives        Int      @default(0)
  averageRating     Decimal? @db.Decimal(3, 2)
  bookings          Booking[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum EquipmentStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  DECOMMISSIONED
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

model Equipment {
  id              String             @id @default(uuid())
  type            String
  brand           String
  model           String?
  size            String?
  serialNumber    String?            @unique
  status          EquipmentStatus    @default(AVAILABLE)
  condition       EquipmentCondition @default(EXCELLENT)
  purchaseDate    DateTime
  purchaseCost    Decimal            @db.Decimal(10, 2)
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

enum StaffType {
  GUIDE
  TRAINER
  CAPTAIN
  ADMIN
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model Staff {
  id             String               @id @default(uuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  phone          String
  type           StaffType
  status         StaffStatus          @default(ACTIVE)
  hireDate       DateTime
  qualifications StaffQualification[]
  availability   StaffAvailability[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model StaffQualification {
  id         String    @id @default(uuid())
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type       String
  agency     String
  number     String
  issueDate  DateTime
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
}

model StaffAvailability {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime
  available Boolean  @default(true)
  reason    String?

  @@unique([staffId, date])
}

enum ActivityType {
  SNORKELING
  DISCOVER_SCUBA
  FUN_DIVE
  OW_CERT
  AOW_CERT
  RESCUE_CERT
  DM_CERT
}

enum TimeSlot {
  MORNING
  AFTERNOON
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  DIRECT
  WALK_IN
  PARTNER
}

model Booking {
  id               String        @id @default(uuid())
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  boatId           String
  boat             Boat          @relation(fields: [boatId], references: [id], onDelete: Restrict)
  siteId           String?
  site             DiveSite?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  activityType     ActivityType
  date             DateTime
  timeSlot         TimeSlot
  status           BookingStatus @default(PENDING)
  participantCount Int
  bookingSource    BookingSource @default(DIRECT)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([boatId, date])
  @@index([customerId])
  @@index([status])
  @@index([date, timeSlot])
}
