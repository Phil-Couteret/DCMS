generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  INSTRUCTOR
  ADMIN
}

enum CustomerType {
  TOURIST
  LOCAL
  RECURRENT
}

// Staff's operational assessment of the diver, independent of certification.
enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum Language {
  ES
  EN
  DE
  FR
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         Role      @default(CUSTOMER)
  customer     Customer?
  staff        Staff?
  dataBreaches DataBreach[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Customer {
  id                    String                  @id @default(uuid())
  userId                String                  @unique
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  phone                 String?
  country               String
  language              Language                @default(EN)
  birthdate             DateTime?
  emergencyContact      Json?
  gender                String?
  notes                 String?                 @db.Text
  loyaltyPoints         Int                     @default(0)
  totalDives            Int                     @default(0)
  customerType          CustomerType            @default(TOURIST)
  centerSkillLevel      SkillLevel?
  isApproved            Boolean                 @default(true)
  // Verification is cleared when the number or expiry changes.
  medicalCertNumber     String?
  medicalCertExpiry     DateTime?
  medicalCertVerifiedAt DateTime?
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?
  insuranceVerifiedAt   DateTime?
  // ownEquipment: brings a full set; the tank is always the center's.
  ownEquipment          Boolean                 @default(false)
  tankSize              String?
  bcdSize               String?
  wetsuitSize           String?
  finsSize              String?
  bootsSize             String?
  certifications        CustomerCertification[]
  bookings              Booking[]
  diveLogEntries        DiveLogParticipant[]
  invoices              Invoice[]
  stays                 Stay[]
  // The partner who registered this customer, if any.
  partnerId             String?
  partner               Partner?                @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([country])
}

// The dive center's own details, shown on invoices and in the backoffice.
// A single row, id "center".
// A diving certification staff recorded from the diver's card.
model CustomerCertification {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agency     String
  level      String
  cardNumber String?
  issueDate  DateTime?
  expiryDate DateTime?
  verifiedAt DateTime?
  verifiedBy String? // email of the staff member who verified it
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId])
}

model CenterSettings {
  id        String   @id @default("center")
  name      String
  legalName String?
  address   String?
  phone     String?
  email     String?
  website   String?
  // Percentage added to net prices on invoices, e.g. 7.00 for 7%.
  taxRate   Decimal  @default(7.00) @db.Decimal(5, 2)
  taxName   String   @default("IGIC")
  updatedAt DateTime @updatedAt
}

// The price list, net of tax. Edited in Settings → Pricing; invoices and the
// public site read it. An activity without a row has no price and cannot be
// invoiced.
model ActivityPrice {
  activityType ActivityType @id
  price        Decimal      @db.Decimal(8, 2)
  updatedAt    DateTime     @updatedAt
}

// Rental items by key (wetsuit, bcd, regulator, maskFins, diveComputer) and
// fullPackage, the price of all five hired together.
model EquipmentPrice {
  key       String   @id
  price     Decimal  @db.Decimal(8, 2)
  updatedAt DateTime @updatedAt
}

// Per-dive rate for fun dives billed together in a stay, from minDives fun
// dives in the stay on, by customer type. The lowest tier starts at 1.
model FunDiveTier {
  minDives  Int      @id
  tourist   Decimal  @db.Decimal(8, 2)
  local     Decimal  @db.Decimal(8, 2)
  recurrent Decimal  @db.Decimal(8, 2)
  updatedAt DateTime @updatedAt
}

model Boat {
  id                 String    @id @default(uuid())
  name               String
  capacity           Int
  status             String    @default("active")
  registrationNumber String
  length             Decimal?  @db.Decimal(5, 2)
  engine             String?
  insuranceExpiry    DateTime?
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  bookings           Booking[]
  trips              Trip[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model DiveSite {
  id                String    @id @default(uuid())
  nameEs            String
  nameEn            String
  nameDe            String
  nameFr            String
  descriptionEs     String    @db.Text
  descriptionEn     String    @db.Text
  descriptionDe     String    @db.Text
  descriptionFr     String    @db.Text
  latitude          Decimal   @db.Decimal(10, 7)
  longitude         Decimal   @db.Decimal(10, 7)
  depthMin          Int
  depthMax          Int
  requiredCertLevel Int
  difficultyLevel   Int
  typicalVisibility Int?
  typicalCurrent    String    @default("none")
  waterTempRange    Json
  marineLife        Json
  pointsOfInterest  Json
  bestSeason        Json
  travelTimeMinutes Int
  maxDiversPerTrip  Int
  accessibility     String    @default("boat_only")
  facilities        Json
  restrictions      Json?
  photos            Json      @default("[]")
  totalDives        Int       @default(0)
  averageRating     Decimal?  @db.Decimal(3, 2)
  bookings          Booking[]
  diveLogs          DiveLog[]
  plannedTrips      Trip[]    @relation("TripPlannedSite")
  actualTrips       Trip[]    @relation("TripActualSite")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum EquipmentStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  DECOMMISSIONED
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

model Equipment {
  id              String             @id @default(uuid())
  type            String
  brand           String
  model           String?
  size            String?
  serialNumber    String?            @unique
  status          EquipmentStatus    @default(AVAILABLE)
  condition       EquipmentCondition @default(EXCELLENT)
  purchaseDate    DateTime
  purchaseCost    Decimal            @db.Decimal(10, 2)
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  maintenanceLogs MaintenanceLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

enum StaffType {
  GUIDE
  TRAINER
  CAPTAIN
  ADMIN
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model Staff {
  id             String               @id @default(uuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  phone          String
  type           StaffType
  status         StaffStatus          @default(ACTIVE)
  hireDate       DateTime
  qualifications StaffQualification[]
  availability   StaffAvailability[]
  diveLogs       DiveLog[]
  trips          TripStaff[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model StaffQualification {
  id         String    @id @default(uuid())
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type       String
  agency     String
  number     String
  issueDate  DateTime
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
}

model StaffAvailability {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime
  available Boolean  @default(true)
  reason    String?

  @@unique([staffId, date])
}

enum ActivityType {
  SNORKELING
  DISCOVER_SCUBA
  FUN_DIVE
  OW_CERT
  AOW_CERT
  RESCUE_CERT
  DM_CERT
}

enum TimeSlot {
  MORNING
  AFTERNOON
  NIGHT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  DIRECT
  WALK_IN
  PARTNER
}

model Booking {
  id               String        @id @default(uuid())
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  boatId           String
  boat             Boat          @relation(fields: [boatId], references: [id], onDelete: Restrict)
  siteId           String?
  site             DiveSite?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  tripId           String?
  trip             Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  activityType     ActivityType
  date             DateTime
  timeSlot         TimeSlot
  status           BookingStatus @default(PENDING)
  participantCount Int
  bookingSource    BookingSource @default(DIRECT)
  notes            String?
  diveLog          DiveLog?
  invoice          Invoice?
  // Set when the booking is billed as part of a stay.
  stayId           String?
  stay             Stay?         @relation(fields: [stayId], references: [id], onDelete: SetNull)
  // The partner (agency) that sold it: they pay the activity, less commission.
  partnerId        String?
  partner          Partner?      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  // Set while the booking is on a partner invoice that is not cancelled.
  partnerInvoiceId String?
  partnerInvoice   PartnerInvoice? @relation(fields: [partnerInvoiceId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([boatId, date])
  @@index([customerId])
  @@index([status])
  @@index([date, timeSlot])
  @@index([tripId])
  @@index([stayId])
  @@index([partnerId])
  @@index([partnerInvoiceId])
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TripStaffRole {
  CAPTAIN
  GUIDE
  TRAINEE_GUIDE
}

// One outing: a boat (or, with no boat, a shore dive) on a date and time slot.
model Trip {
  id            String      @id @default(uuid())
  date          DateTime
  timeSlot      TimeSlot
  boatId        String?
  boat          Boat?       @relation(fields: [boatId], references: [id], onDelete: Restrict)
  plannedSiteId String?
  plannedSite   DiveSite?   @relation("TripPlannedSite", fields: [plannedSiteId], references: [id], onDelete: SetNull)
  actualSiteId  String?
  actualSite    DiveSite?   @relation("TripActualSite", fields: [actualSiteId], references: [id], onDelete: SetNull)
  status        TripStatus  @default(PLANNED)
  maxDivers     Int         @default(10)
  notes         String?
  // Post-dive report, in center local time (HH:mm).
  entryTime     String?     @db.VarChar(5)
  exitTime      String?     @db.VarChar(5)
  reportNotes   String?     @db.Text
  completedAt   DateTime?
  bookings      Booking[]
  staff         TripStaff[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // PostgreSQL treats NULLs as distinct, so this does not stop two shore
  // trips (boatId null) in the same slot. TripsService checks that case.
  @@unique([date, timeSlot, boatId])
  @@index([date])
}

model TripStaff {
  id          String        @id @default(uuid())
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  staffId     String
  staff       Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  role        TripStaffRole
  confirmedAt DateTime?

  @@unique([tripId, staffId])
  @@index([staffId])
}

enum IncidentSeverity {
  MINOR
  MODERATE
  SERIOUS
  CRITICAL
}

model DiveLog {
  id                String               @id @default(uuid())
  logNumber         String               @unique
  bookingId         String               @unique
  booking           Booking              @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  siteId            String
  site              DiveSite             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  guideId           String?
  guide             Staff?               @relation(fields: [guideId], references: [id], onDelete: SetNull)
  date              DateTime
  entryTime         DateTime
  exitTime          DateTime
  maxDepth          Int
  avgDepth          Int?
  duration          Int
  visibility        Int?
  waterTemp         Int?
  weatherConditions String?
  seaConditions     String?
  airStartBar       Int?
  airEndBar         Int?
  notes             String?
  participants      DiveLogParticipant[]
  signatures        DiveLogSignature[]
  incident          Incident?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model DiveLogParticipant {
  id         String   @id @default(uuid())
  diveLogId  String
  diveLog    DiveLog  @relation(fields: [diveLogId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  role       String   @default("diver")

  @@unique([diveLogId, customerId])
}

model DiveLogSignature {
  id            String   @id @default(uuid())
  diveLogId     String
  diveLog       DiveLog  @relation(fields: [diveLogId], references: [id], onDelete: Cascade)
  signerType    String
  signerId      String
  signerName    String
  signatureData String   @db.Text
  signedAt      DateTime @default(now())
}

model Incident {
  id                    String           @id @default(uuid())
  diveLogId             String           @unique
  diveLog               DiveLog          @relation(fields: [diveLogId], references: [id], onDelete: Cascade)
  type                  String
  severity              IncidentSeverity
  description           String           @db.Text
  actionsTaken          String           @db.Text
  reportedToAuthorities Boolean          @default(false)
  createdAt             DateTime         @default(now())
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  // Exactly one of bookingId and stayId is set (a CHECK constraint in the
  // database): an invoice bills one booking, or a whole stay.
  bookingId     String?       @unique
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  stayId        String?
  stay          Stay?         @relation(fields: [stayId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  currency      String        @default("EUR")
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  items         InvoiceItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([stayId])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  type        String
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("EUR")
  method          PaymentMethod
  stripePaymentId String?       @unique
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  refunds         Refund[]
  createdAt       DateTime      @default(now())
}

model Refund {
  id             String   @id @default(uuid())
  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount         Decimal  @db.Decimal(10, 2)
  reason         String
  stripeRefundId String?  @unique
  processedAt    DateTime @default(now())
}

model MaintenanceLog {
  id          String    @id @default(uuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date        DateTime
  technician  String
  type        String
  notes       String?
  cost        Decimal?  @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  @@index([equipmentId, date])
}

// Financial page: day-to-day money that does not go through invoices.

enum ExpenseCategory {
  GASOLINE
  TANK_NET
  GLUE
  EQUIPMENT
  MAINTENANCE
  OTHER
}

// amount includes tax; tax is the part of it that can be deducted on the
// quarterly declaration.
model Expense {
  id          String          @id @default(uuid())
  date        DateTime        @db.Date
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  tax         Decimal         @db.Decimal(10, 2)
  notes       String?
  createdBy   String? // email of the staff member who recorded it
  createdAt   DateTime        @default(now())

  @@index([date])
}

// Income that is not an invoice payment, e.g. an equipment sale.
model ManualIncome {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  description String
  amount      Decimal  @db.Decimal(10, 2)
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([date])
}

// A day's figures frozen when staff close the day. Closing again replaces them.
model ClosedDay {
  id       String   @id @default(uuid())
  date     DateTime @unique @db.Date
  summary  Json
  closedBy String
  closedAt DateTime @default(now())
}

// A customer's visit: their bookings over up to 30 days, billed together on
// one invoice with volume pricing for fun dives. The bookings in an open stay
// are worked out from the dates (StaysService); this row holds the extra costs
// and, once billed, which bookings the invoice covered. A customer has at most
// one OPEN stay (StaysService takes a per-customer lock).
enum StayStatus {
  OPEN
  BILLED
}

enum StayCostCategory {
  INSURANCE
  EQUIPMENT
  CLOTHES
  GOODIES
  BEVERAGES
  OTHER
}

model Stay {
  id         String     @id @default(uuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status     StayStatus @default(OPEN)
  billedAt   DateTime?
  bookings   Booking[]
  costs      StayCost[]
  invoices   Invoice[] // a cancelled invoice reopens the stay; billing again adds one
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, status])
}

// Sold during a stay and billed with it: insurance, merchandise, drinks.
// Prices are net; the invoice adds tax.
model StayCost {
  id          String           @id @default(uuid())
  stayId      String
  stay        Stay             @relation(fields: [stayId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  category    StayCostCategory
  description String
  quantity    Int
  unitPrice   Decimal          @db.Decimal(10, 2)
  total       Decimal          @db.Decimal(10, 2)
  notes       String?
  createdBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([stayId])
}

// An agency or reseller that sells the center's activities to its own
// clients. It signs in to the partner portal with its contact email or API
// key and the API secret, which is stored hashed and shown only once.
model Partner {
  id             String           @id @default(uuid())
  name           String
  companyName    String
  contactEmail   String           @unique
  contactPhone   String?
  // Percentage of the booking value the partner keeps, e.g. 15.00.
  commissionRate Decimal          @db.Decimal(5, 2)
  isActive       Boolean          @default(true)
  apiKey         String           @unique
  apiSecretHash  String
  notes          String?
  bookings       Booking[]
  customers      Customer[]
  invoices       PartnerInvoice[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum PartnerInvoiceStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

// What a partner owes the center for its bookings in a period: their
// catalogue value less the partner's commission, plus tax. Amounts and the
// rates used are copied at creation so the invoice never changes afterwards.
model PartnerInvoice {
  id             String               @id @default(uuid())
  invoiceNumber  String               @unique // PINV-YYYY-0001
  partnerId      String
  partner        Partner              @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  periodFrom     DateTime             @db.Date
  periodTo       DateTime             @db.Date
  dueDate        DateTime             @db.Date
  commissionRate Decimal              @db.Decimal(5, 2)
  gross          Decimal              @db.Decimal(10, 2) // catalogue value of the bookings
  commission     Decimal              @db.Decimal(10, 2)
  subtotal       Decimal              @db.Decimal(10, 2) // gross - commission
  taxName        String
  taxRate        Decimal              @db.Decimal(5, 2)
  tax            Decimal              @db.Decimal(10, 2)
  total          Decimal              @db.Decimal(10, 2)
  paidAmount     Decimal              @default(0) @db.Decimal(10, 2)
  status         PartnerInvoiceStatus @default(PENDING)
  paidAt         DateTime?
  notes          String?
  createdBy      String?
  lines          PartnerInvoiceLine[]
  bookings       Booking[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([partnerId])
}

// One booking on a partner invoice, as it was valued then.
model PartnerInvoiceLine {
  id               String         @id @default(uuid())
  partnerInvoiceId String
  partnerInvoice   PartnerInvoice @relation(fields: [partnerInvoiceId], references: [id], onDelete: Cascade)
  bookingId        String // kept as text: the line stays if the booking is deleted
  date             DateTime       @db.Date
  description      String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(10, 2)
  total            Decimal        @db.Decimal(10, 2)

  @@index([partnerInvoiceId])
}

enum BreachSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Moves forward only: DETECTED → ASSESSED → REPORTED → RESOLVED, steps may
// be skipped (a breach unlikely to harm anyone need not be reported).
enum BreachStatus {
  DETECTED
  ASSESSED
  REPORTED
  RESOLVED
}

// The GDPR data breach register (Art. 33(5)). A breach must be reported to
// the authority within 72 hours of detectedAt; one still DETECTED or ASSESSED
// after that, and not reported, is overdue.
model DataBreach {
  id                  String         @id @default(uuid())
  title               String
  detectedAt          DateTime
  severity            BreachSeverity
  status              BreachStatus   @default(DETECTED)
  description         String         @db.Text
  // Array of data type keys, e.g. ["customer_data", "medical_data"].
  affectedDataTypes   Json
  estimatedAffected   Int?
  reportedToAuthority Boolean        @default(false)
  reportedAt          DateTime?
  authorityReference  String?
  resolutionDetails   String?        @db.Text
  resolutionDate      DateTime?
  createdById         String
  createdBy           User           @relation(fields: [createdById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status])
  @@index([detectedAt])
}
