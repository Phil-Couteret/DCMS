generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  INSTRUCTOR
  ADMIN
}

enum Language {
  ES
  EN
  DE
  FR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(CUSTOMER)
  customer     Customer?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  phone            String?
  country          String
  language         Language  @default(EN)
  birthdate        DateTime?
  emergencyContact Json?
  loyaltyPoints    Int       @default(0)
  totalDives       Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([country])
}

model Boat {
  id                 String    @id @default(uuid())
  name               String
  capacity           Int
  status             String    @default("active")
  registrationNumber String
  length             Decimal?  @db.Decimal(5, 2)
  engine             String?
  insuranceExpiry    DateTime?
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model DiveSite {
  id                String   @id @default(uuid())
  nameEs            String
  nameEn            String
  nameDe            String
  nameFr            String
  descriptionEs     String   @db.Text
  descriptionEn     String   @db.Text
  descriptionDe     String   @db.Text
  descriptionFr     String   @db.Text
  latitude          Decimal  @db.Decimal(10, 7)
  longitude         Decimal  @db.Decimal(10, 7)
  depthMin          Int
  depthMax          Int
  requiredCertLevel Int
  difficultyLevel   Int
  typicalVisibility Int?
  typicalCurrent    String   @default("none")
  waterTempRange    Json
  marineLife        Json
  pointsOfInterest  Json
  bestSeason        Json
  travelTimeMinutes Int
  maxDiversPerTrip  Int
  accessibility     String   @default("boat_only")
  facilities        Json
  restrictions      Json?
  photos            Json     @default("[]")
  totalDives        Int      @default(0)
  averageRating     Decimal? @db.Decimal(3, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
